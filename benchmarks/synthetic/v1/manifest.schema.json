{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uniscan.invalid/synthetic-benchmark-v1.schema.json",
  "title": "UniScan synthetic benchmark manifest v1",
  "type": "object",
  "required": ["schema", "corpus_id", "revision", "provenance", "generator", "metrics", "fixtures", "cases"],
  "properties": {
    "schema": {"const": "uniscan.synthetic-benchmark.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "provenance": {
      "type": "object",
      "required": ["source_kind", "contains_private_data", "external_assets"],
      "properties": {
        "source_kind": {"const": "procedural-original"},
        "contains_private_data": {"const": false},
        "external_assets": {"type": "array", "maxItems": 0}
      }
    },
    "generator": {
      "type": "object",
      "required": ["name", "version", "seed", "python", "pymupdf"],
      "properties": {
        "name": {"const": "generate.py"},
        "version": {"type": "string"},
        "seed": {"type": "integer"},
        "python": {"type": "string"},
        "pymupdf": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "required": ["model_status", "text", "searchability", "geometry"],
      "properties": {
        "model_status": {"const": "not_run"},
        "text": {"type": "object"},
        "searchability": {"type": "object"},
        "geometry": {"type": "object"}
      }
    },
    "fixtures": {"type": "array", "minItems": 1},
    "cases": {"type": "array", "minItems": 2}
  }
}
