# Required host-local configuration. Copy this file to .env and set the UUID
# reported for physical GPU index 0 by:
# nvidia-smi --id=0 --query-gpu=uuid --format=csv,noheader,nounits
# Never commit the populated .env file. Inside the container, this single
# reserved host device is always exposed as cuda:0.
UNISCAN_GPU_DEVICE_ID=
